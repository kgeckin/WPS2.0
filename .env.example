# Copy to .env and enter locally issued credentials. Never commit .env.
DB_HOST=127.0.0.1
DB_USER=wps_user
DB_PASSWORD=replace_with_local_password
DB_NAME=wps_local

# Run python generate_key.py to set SECRET_KEY.
SECRET_KEY=
TOKEN_VALID_SEC=300

# The awareness site is local-only in this revision.
FLASK_PORT=5000
AWARENESS_BASE_URL=http://127.0.0.1:5000
CHROME_PROFILE_DIR=
CHROMEDRIVER_PATH=
